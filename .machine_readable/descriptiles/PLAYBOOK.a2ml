[metadata]
project = "pons-asinorum"
version = "0.1.0-dev.1"
last-updated = "2026-09-09"
[development]
check = "just check"
e2e = "just e2e"
benchmark = "just bench"
catalogue = "just catalogue"
man = "just man"
docs = "just docs"
rsr = "just rsr-profile /path/to/standards"
[container]
build = "just container-build"
smoke = "just container-smoke"
transactional-wrapper = "build/container/transactional-scan.sh"
strict-host-prerequisites = "Running firewalld and enforcing SELinux with reviewed labels; wrapper refuses otherwise"
[release]
status = "not ready; original-plan acceptance work remains"
preconditions = ["complete docs/PLAN.adoc gates", "review docs/AUDIT.adoc", "verify local and remote checks", "verify release artefacts", "maintainer approval"]
[incident-response]
procedure = "Preserve diagnostics and tool versions; follow .github/SECURITY.md for confidential reports; do not weaken host policy to make a scan pass"
