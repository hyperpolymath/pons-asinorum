# SPDX-License-Identifier: MPL-2.0
[metadata]
project = "pons-asinorum"
version = "0.1.0-dev.1"
last-updated = "2026-09-09"
[agent-permissions]
can-edit-source = true
can-edit-tests = true
can-edit-docs = true
can-edit-config = true
[constraints]
implementation = "Rust; Bash for project tooling; analysed-language fixtures are data"
python-fixtures = "JSON string encoding, decoded in Rust tests"
evidence = "Never claim CFG/dataflow, proof, deployment or external service capability from a scaffold"
negative-corpus = "Mandatory for each registered rule"
external-execution = "Explicit user-facing tool commands only; fixed argv and bounded execution"
secrets = "Never commit credentials"
[verification]
command = "just check"
release = "Complete docs/PLAN.adoc acceptance gates and docs/AUDIT.adoc gaps before tagging"
