{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "execution",
    "scanned",
    "counts",
    "findings",
    "evidence_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4.0"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_commit",
        "source_dirty"
      ],
      "properties": {
        "name": {
          "const": "pons"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "minLength": 1
        },
        "source_dirty": {
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code"
      ],
      "properties": {
        "status": {
          "const": "completed"
        },
        "exit_code": {
          "anyOf": [
            {
              "enum": [
                0,
                1,
                2
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scanned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "coverage_status",
        "inventory",
        "coverage_failures",
        "files",
        "suppressed_findings",
        "languages",
        "transcoded",
        "skipped"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "coverage_status": {
          "enum": [
            "complete-within-policy",
            "partial",
            "no-applicable-input"
          ]
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "language",
              "outcome",
              "reason",
              "parser",
              "artifact_digest",
              "transcoded",
              "analysis_notes",
              "analysis_complete"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "file",
                  "directory",
                  "unknown"
                ]
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "analysed",
                  "unsupported",
                  "excluded-by-policy",
                  "parse-error",
                  "timeout",
                  "unreadable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "parser": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "artifact_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^blake3:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transcoded": {
                "type": "boolean"
              },
              "analysis_notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "analysis_complete": {
                "type": "boolean"
              }
            }
          }
        },
        "coverage_failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed_findings": {
          "type": "integer",
          "minimum": 0
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transcoded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_evidence",
        "total"
      ],
      "properties": {
        "by_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "HEURISTIC",
            "DATAFLOW",
            "PROTOCOL",
            "SPECULATIVE"
          ],
          "properties": {
            "HEURISTIC": {
              "type": "integer",
              "minimum": 0
            },
            "DATAFLOW": {
              "type": "integer",
              "minimum": 0
            },
            "PROTOCOL": {
              "type": "integer",
              "minimum": 0
            },
            "SPECULATIVE": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "tier",
          "evidence",
          "severity",
          "location",
          "message",
          "evidence_note",
          "counter_condition"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3"
            ]
          },
          "evidence": {
            "enum": [
              "HEURISTIC",
              "DATAFLOW",
              "PROTOCOL",
              "SPECULATIVE"
            ]
          },
          "severity": {
            "enum": [
              "INFO",
              "WARN",
              "ERROR"
            ]
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "byte_start",
              "byte_end",
              "line_start",
              "col_start",
              "line_end",
              "col_end"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "byte_start": {
                "type": "integer",
                "minimum": 0
              },
              "byte_end": {
                "type": "integer",
                "minimum": 0
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "col_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "col_end": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence_note": {
            "type": "string",
            "minLength": 1
          },
          "counter_condition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "T0"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "const": "HEURISTIC"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "T1"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "const": "DATAFLOW"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "T2"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "const": "PROTOCOL"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "T3"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "const": "SPECULATIVE"
                }
              }
            }
          }
        ]
      }
    },
    "evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target",
        "execution_outcome",
        "parser_inventory",
        "records"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "dirty"
          ],
          "properties": {
            "commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dirty": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "execution_outcome": {
          "enum": [
            "complete-within-policy",
            "partial",
            "no-applicable-input"
          ]
        },
        "parser_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "language",
              "outcome",
              "reason",
              "parser",
              "artifact_digest",
              "transcoded",
              "analysis_notes",
              "analysis_complete"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "file",
                  "directory",
                  "unknown"
                ]
              },
              "language": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "analysed",
                  "unsupported",
                  "excluded-by-policy",
                  "parse-error",
                  "timeout",
                  "unreadable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "parser": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "artifact_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^blake3:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transcoded": {
                "type": "boolean"
              },
              "analysis_notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "analysis_complete": {
                "type": "boolean"
              }
            }
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fingerprint",
              "producer",
              "correlation_group",
              "rule",
              "tier",
              "evidence",
              "confidence",
              "path",
              "line",
              "trace",
              "assumptions",
              "unknown_edges",
              "counterconditions"
            ],
            "properties": {
              "fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "producer": {
                "type": "string",
                "minLength": 1
              },
              "correlation_group": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "enum": [
                  "T0",
                  "T1",
                  "T2",
                  "T3"
                ]
              },
              "evidence": {
                "enum": [
                  "HEURISTIC",
                  "DATAFLOW",
                  "PROTOCOL",
                  "SPECULATIVE"
                ]
              },
              "confidence": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "trace": {
                "type": "string",
                "minLength": 1
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unknown_edges": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "counterconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "tier": {
                      "const": "T0"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "const": "HEURISTIC"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tier": {
                      "const": "T1"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "const": "DATAFLOW"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tier": {
                      "const": "T2"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "const": "PROTOCOL"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tier": {
                      "const": "T3"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "const": "SPECULATIVE"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Pons evidence exchange 1.0.0",
      "$comment": "SPDX-License-Identifier: MPL-2.0; shape validation must be followed by pons validate-report semantic checks."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: MPL-2.0; envelope shape, not a security verdict.",
  "title": "Pons scan envelope 0.4.0"
}
